# Miscellaneous
*.class
*.log
.env
*.pyc
*.swp
.DS_Store
.atom/
.env/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/
.claude/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Kotlin compiler build session/cache (transient, Kotlin 2.x)
.kotlin/
**/.kotlin/

# The LNReader bundle's build folder
tool/lnreader_deps/node_modules/
tool/lnreader_deps/package-lock.json

# Internal docs — plans, architecture, audits, backend notes. This repository
# is public; these stay on the developer's machine and are never published.
# Only the images the README shows are tracked.
/docs/*
!/docs/images/
