<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's picture of the medium widget, filled in. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/items"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/item_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="0dp"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/poster_0"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/widget_preview_poster_a"
                        android:clipToOutline="true"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <ProgressBar
                        android:id="@+id/progress_0"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="5dp"
                        android:max="1000"
                        android:progress="620"
                        android:progressDrawable="@drawable/widget_progress" />
                    <ImageView
                        android:id="@+id/profile_avatar"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="6dp"
                        android:contentDescription="@null"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/streak_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/widget_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="5dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="7dp"
                        android:paddingBottom="2dp">

                        <ImageView
                            android:id="@+id/streak_icon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_widget_flame" />

                        <TextView
                            android:id="@+id/streak_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:textColor="#FFFFA94D"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:text="23" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/title_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="@string/widget_preview_title_0" />

                <TextView
                    android:id="@+id/sub_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FF8A8A8A"
                    android:textSize="10.5sp"
                    android:text="@string/widget_preview_sub_0" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/item_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/poster_1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/widget_preview_poster_b"
                        android:clipToOutline="true"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <ProgressBar
                        android:id="@+id/progress_1"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="5dp"
                        android:max="1000"
                        android:progress="300"
                        android:progressDrawable="@drawable/widget_progress" />
                </FrameLayout>

                <TextView
                    android:id="@+id/title_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="@string/widget_preview_title_1" />

                <TextView
                    android:id="@+id/sub_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FF8A8A8A"
                    android:textSize="10.5sp"
                    android:text="@string/widget_preview_sub_1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/item_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/poster_2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/widget_preview_poster_c"
                        android:clipToOutline="true"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <ProgressBar
                        android:id="@+id/progress_2"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="5dp"
                        android:max="1000"
                        android:progress="800"
                        android:progressDrawable="@drawable/widget_progress" />
                </FrameLayout>

                <TextView
                    android:id="@+id/title_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="@string/widget_preview_title_2" />

                <TextView
                    android:id="@+id/sub_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FF8A8A8A"
                    android:textSize="10.5sp"
                    android:text="@string/widget_preview_sub_2" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/next_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_row_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_clock" />

            <TextView
                android:id="@+id/next_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFCCCCCC"
                android:textSize="11.5sp"
                android:text="@string/widget_preview_next" />

            <TextView
                android:id="@+id/next_in"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#FF8FD4FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="2d 5h" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
