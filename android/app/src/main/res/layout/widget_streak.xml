<?xml version="1.0" encoding="utf-8"?>
<!-- The streak: the flame, the days, this week as dots, and whose it is. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_streak"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/profile_avatar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:contentDescription="@null"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/flame"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_flame" />

        <TextView
            android:id="@+id/days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2dp"
            android:fontFamily="sans-serif-black"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:textColor="#FFFFC078"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
        <ImageView
            android:id="@+id/dot_0"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="0dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_off" />
        <ImageView
            android:id="@+id/dot_1"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_off" />
        <ImageView
            android:id="@+id/dot_2"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_off" />
        <ImageView
            android:id="@+id/dot_3"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_off" />
        <ImageView
            android:id="@+id/dot_4"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_off" />
        <ImageView
            android:id="@+id/dot_5"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_off" />
        <ImageView
            android:id="@+id/dot_6"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_off" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/locked"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_lock" />

        <TextView
            android:id="@+id/locked_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
