<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's picture of the streak widget. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_streak"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/profile_avatar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:contentDescription="@null"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/medal"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_preview_medal" />

        <!-- The count beside its words: plain white on the card, not struck
             in the medal, where a number in orange on pewter jarred. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
            android:text="2"
                android:visibility="visible" />

            <TextView
                android:id="@+id/label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFC078"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:text="@string/widget_streak_label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
        <ImageView
            android:id="@+id/dot_0"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="0dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_on" />
        <ImageView
            android:id="@+id/dot_1"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_on" />
        <ImageView
            android:id="@+id/dot_2"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_on" />
        <ImageView
            android:id="@+id/dot_3"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_on" />
        <ImageView
            android:id="@+id/dot_4"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_today" />
        <ImageView
            android:id="@+id/dot_5"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_off" />
        <ImageView
            android:id="@+id/dot_6"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_off" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
