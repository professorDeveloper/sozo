+import { CheerioAPI, load as parseHTML } from 'cheerio';
+import { fetchApi } from '@libs/fetch';
+import { Plugin } from '@/types/plugin';
+import { storage } from '@libs/storage';
+import { defaultCover } from '@libs/defaultCover';
+
+type ChapterJSON = {
+  id: number;
+  slug: string;
+  volume: string;
+  chapter_no: string;
+  subtitle: string | null;
+  locked: boolean;
+};
+
+class KDTNovelsPlugin implements Plugin.PluginBase {
+  id = 'kdtnovels';
+  name = 'KDT Novels';
+  icon = 'src/en/kdtnovels/icon.png';
+  site = 'https://kdtnovels.net/';
+  version = '1.1.10';
+
+  hideLocked = storage.get('hideLocked');
+  pluginSettings = {
+    hideLocked: {
+      value: '',
+      label: 'Hide locked chapters',
+      type: 'Switch',
+    },
+  };
+
+  parseNovels(loadedCheerio: CheerioAPI): Plugin.NovelItem[] {
+    return loadedCheerio('a[href^="/series/"]:has(h3)')
+      .map((_, el) => {
+        const cover = loadedCheerio(el).find('img').attr('src');
+        return {
+          name: loadedCheerio(el).find('h3').text().trim(),
+          cover: cover ? new URL(cover, this.site).href : defaultCover,
+          path: loadedCheerio(el).attr('href')!.replace(/^\//, ''),
+        };
+      })
+      .toArray();
+  }
+
+  async popularNovels(page: number): Promise<Plugin.NovelItem[]> {
+    const body = await fetchApi(`${this.site}search/?page=${page}`).then(r =>
+      r.text(),
+    );
+    return this.parseNovels(parseHTML(body));
+  }
+
+  async parseNovel(novelPath: string): Promise<Plugin.SourceNovel> {
+    const body = await fetchApi(this.site + novelPath).then(r => r.text());
+    const loadedCheerio = parseHTML(body);
+
+    const title = loadedCheerio('main h1').first();
+    const cover = loadedCheerio('main button img').first().attr('src');
+    const novel: Plugin.SourceNovel = {
+      path: novelPath,
+      name: title.text().trim(),
+      cover: cover ? new URL(cover, this.site).href : defaultCover,
+      author: title.parent().next('p').find('span').first().text().trim(),
+      summary: loadedCheerio('main div[style*="line-clamp"]').text().trim(),
+      genres: loadedCheerio('main a[href^="/search/?genre="]')
+        .map((_, el) => loadedCheerio(el).text().trim())
+        .toArray()
+        .join(','),
+    };
+
+    // The chapter list is only present in the RSC payload
+    const payload = Array.from(
+      body.matchAll(/self\.__next_f\.push\(\[1,"((?:[^"\\]|\\.)*)"\]\)/g),
+    )
+      .map(m => JSON.parse(`"${m[1]}"`))
+      .join('');
+    const chapters: ChapterJSON[] = Array.from(
+      payload.matchAll(/\{"id":\d+,"slug":[^{}]*"chapter_no":[^{}]*\}/g),
+    ).map(m => JSON.parse(m[0]));
+
+    novel.chapters = chapters
+      .filter(chapter => !(this.hideLocked && chapter.locked))
+      .map((chapter, index) => {
+        const name =
+          `Vol. ${chapter.volume} Ch. ${chapter.chapter_no}` +
+          (chapter.subtitle ? `: ${chapter.subtitle}` : '');
+        return {
+          name: chapter.locked ? `🔒 ${name}` : name,
+          path: chapter.slug + '/',
+          chapterNumber: index + 1,
+        };
+      });
+
+    return novel;
+  }
+
+  async parseChapter(chapterPath: string): Promise<string> {
+    const body = await fetchApi(this.site + chapterPath).then(r => r.text());
+    return parseHTML(body)('article.reader-content').html() || '';
+  }
+
+  async searchNovels(
+    searchTerm: string,
+    page: number,
+  ): Promise<Plugin.NovelItem[]> {
+    const body = await fetchApi(
+      `${this.site}search/?q=${encodeURIComponent(searchTerm)}&page=${page}`,
+    ).then(r => r.text());
+    return this.parseNovels(parseHTML(body));
+  }
+}
+
+export default new KDTNovelsPlugin();
