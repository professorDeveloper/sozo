@@ -0,0 +1,119 @@
+import { CheerioAPI, load as parseHTML } from 'cheerio';
+import { fetchApi } from '@libs/fetch';
+import { Plugin } from '@/types/plugin';
+
+class RagnarScans implements Plugin.PluginBase {
+  id = 'ragnarscans';
+  name = 'Ragnar Scans';
+  icon = 'multisrc/madara/ragnarscans/icon.png';
+  site = 'https://ragnarscans.net/';
+  version = '2.2.0';
+
+  private async getCheerio(url: string): Promise<CheerioAPI> {
+    const res = await fetchApi(url);
+    if (!res.ok) throw new Error('Could not reach site (' + res.status + ')');
+    return parseHTML(await res.text());
+  }
+
+  private novelPath(href: string | undefined): string | undefined {
+    return href?.match(/\/(novel\/[^/?#]+\/)$/)?.[1];
+  }
+
+  async popularNovels(pageNo: number): Promise<Plugin.NovelItem[]> {
+    // The whole novel catalogue fits on the first page of /novel/.
+    if (pageNo > 1) return [];
+    const $ = await this.getCheerio(this.site + 'novel/');
+    const novels: Plugin.NovelItem[] = [];
+    $('.manga-card').each((_, el) => {
+      const path = this.novelPath($(el).find('a').first().attr('href'));
+      if (!path) return;
+      novels.push({
+        name: $(el).find('.manga-card-title').first().text().trim(),
+        path,
+        cover: $(el).find('img').first().attr('src'),
+      });
+    });
+    return novels;
+  }
+
+  async parseNovel(novelPath: string): Promise<Plugin.SourceNovel> {
+    const $ = await this.getCheerio(this.site + novelPath);
+
+    const novel: Plugin.SourceNovel = {
+      path: novelPath,
+      name: $('h1').first().text().trim(),
+      cover: $('meta[property="og:image"]').attr('content'),
+      summary: $('.manga-description p').text().trim(),
+      genres: Array.from(
+        new Set(
+          $('a[href*="/genre/"]')
+            .map((_, el) => $(el).text().trim())
+            .get(),
+        ),
+      ).join(', '),
+    };
+
+    const parseChapters = (page: CheerioAPI) =>
+      page('.chapter-list .chapter-item')
+        .map((_, el) => ({
+          name: page(el).find('h3').text().trim(),
+          path: (page(el).find('a').attr('href') || '').replace(this.site, ''),
+          releaseTime: page(el).find('time').attr('datetime'),
+        }))
+        .get()
+        .filter(chapter => chapter.path);
+
+    const chapters: Plugin.ChapterItem[] = parseChapters($);
+    const lastPage = Math.max(
+      1,
+      ...$('a[href*="/bolum/page/"]')
+        .map((_, el) =>
+          parseInt(
+            $(el)
+              .attr('href')
+              ?.match(/\/page\/(\d+)/)?.[1] || '1',
+          ),
+        )
+        .get(),
+    );
+    for (let page = 2; page <= lastPage; page++) {
+      chapters.push(
+        ...parseChapters(
+          await this.getCheerio(
+            this.site + novelPath + 'bolum/page/' + page + '/',
+          ),
+        ),
+      );
+    }
+    novel.chapters = chapters.reverse();
+
+    return novel;
+  }
+
+  async parseChapter(chapterPath: string): Promise<string> {
+    const $ = await this.getCheerio(this.site + chapterPath);
+    return $('#chapter-content').html() || '';
+  }
+
+  async searchNovels(
+    searchTerm: string,
+    pageNo: number,
+  ): Promise<Plugin.NovelItem[]> {
+    const $ = await this.getCheerio(
+      this.site + 'page/' + pageNo + '/?s=' + encodeURIComponent(searchTerm),
+    );
+    const novels: Plugin.NovelItem[] = [];
+    $('.uk-h3 a').each((_, el) => {
+      const path = this.novelPath($(el).attr('href'));
+      if (!path) return;
+      novels.push({
+        name: $(el).text().trim(),
+        path,
+        cover: $(el).closest('.uk-grid-small').find('img').first().attr('src'),
+      });
+    });
+    return novels;
+  }
+}
+
+export default new RagnarScans();
