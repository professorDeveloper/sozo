index 0000000..ec8e9f9
--- /dev/null
+++ b/plugins/turkish/ekitaplar.ts
@@ -0,0 +1,115 @@
+import { CheerioAPI, load as parseHTML } from 'cheerio';
+import { fetchApi } from '@libs/fetch';
+import { NovelStatus } from '@libs/novelStatus';
+import { Plugin } from '@/types/plugin';
+
+class EKitaplar implements Plugin.PluginBase {
+  id = 'ekitaplar';
+  name = 'E-KİTAPLAR';
+  icon = 'multisrc/madara/ekitaplar/icon.png';
+  site = 'https://e-kitaplar.com/';
+  version = '2.2.0';
+
+  private async getCheerio(url: string): Promise<CheerioAPI> {
+    const res = await fetchApi(url);
+    if (!res.ok) throw new Error('Could not reach site (' + res.status + ')');
+    return parseHTML(await res.text());
+  }
+
+  private parseNovels($: CheerioAPI): Plugin.NovelItem[] {
+    const novels = new Map<string, Plugin.NovelItem>();
+    $('main a[href*="/novel/"]').each((_, el) => {
+      const href = $(el).attr('href') || '';
+      const match = href.match(/\/(novel\/[^/?#]+\/)/);
+      const name = $(el).text().trim();
+      if (!match || !name || novels.has(match[1])) return;
+      const card = $(el).closest('.rounded-lg');
+      novels.set(match[1], {
+        name,
+        path: match[1],
+        cover: card.find('img').first().attr('src'),
+      });
+    });
+    return Array.from(novels.values());
+  }
+
+  async popularNovels(pageNo: number): Promise<Plugin.NovelItem[]> {
+    const $ = await this.getCheerio(this.site + 'novels/?paged=' + pageNo);
+    return this.parseNovels($);
+  }
+
+  async parseNovel(novelPath: string): Promise<Plugin.SourceNovel> {
+    const $ = await this.getCheerio(this.site + novelPath);
+
+    const status = $('main h1')
+      .first()
+      .parent()
+      .parent()
+      .find('span.rounded-full')
+      .first()
+      .text()
+      .trim();
+
+    const novel: Plugin.SourceNovel = {
+      path: novelPath,
+      name: $('main h1').first().text().trim(),
+      cover: $('.ek-book-cover img').attr('src'),
+      author: $('main a[href*="/novel-author/"]').first().text().trim(),
+      genres: $('main a[href*="/genre/"]')
+        .map((_, el) => $(el).text().trim())
+        .get()
+        .join(', '),
+      summary: $('main .prose').first().text().trim(),
+      status:
+        status === 'Devam Ediyor'
+          ? NovelStatus.Ongoing
+          : status === 'Tamamlandı'
+            ? NovelStatus.Completed
+            : status === 'Ara Verildi'
+              ? NovelStatus.OnHiatus
+              : NovelStatus.Unknown,
+    };
+
+    const chapters: Plugin.ChapterItem[] = [];
+    $('.chapter-row').each((_, el) => {
+      const link = $(el).find('a').first();
+      const href = link.attr('href');
+      if (!href) return;
+      // Chapters sold for "Parşömen" carry a price badge next to the title.
+      const locked = $(el).find('span.bg-yellow-100').length > 0;
+      chapters.push({
+        name: (locked ? '🔒 ' : '') + link.text().trim(),
+        path: href.replace(this.site, ''),
+        releaseTime: $(el).find('p.text-xs').first().text().trim(),
+        chapterNumber: Number($(el).attr('data-chapter-num')) || undefined,
+      });
+    });
+    novel.chapters = chapters.sort(
+      (a, b) => (a.chapterNumber || 0) - (b.chapterNumber || 0),
+    );
+
+    return novel;
+  }
+
+  async parseChapter(chapterPath: string): Promise<string> {
+    const $ = await this.getCheerio(this.site + chapterPath);
+    return $('#chapter-content').html() || '';
+  }
+
+  async searchNovels(
+    searchTerm: string,
+    pageNo: number,
+  ): Promise<Plugin.NovelItem[]> {
+    const $ = await this.getCheerio(
+      this.site +
+        'page/' +
+        pageNo +
+        '/?s=' +
+        encodeURIComponent(searchTerm) +
+        '&post_type=wp-manga',
+    );
+    return this.parseNovels($);
+  }
+}
+
+export default new EKitaplar();
