+++ b/plugins/english/mtl-novel.ts
@@ -0,0 +1,109 @@
+import { CheerioAPI, load as parseHTML } from 'cheerio';
+import { fetchApi } from '@libs/fetch';
+import { Plugin } from '@/types/plugin';
+import { defaultCover } from '@libs/defaultCover';
+import { NovelStatus } from '@libs/novelStatus';
+
+class MTLNovelPlugin implements Plugin.PluginBase {
+  id = 'mtl-novel';
+  name = 'MTL-Novel';
+  icon = 'src/en/mtl-novel/icon.png';
+  site = 'https://mtl-novel.com/';
+  version = '2.2.0';
+
+  parseNovels(loadedCheerio: CheerioAPI): Plugin.NovelItem[] {
+    return loadedCheerio('.box.wide')
+      .map((_, el) => {
+        const title = loadedCheerio(el).find('a.list-title');
+        const url = title.attr('href');
+        if (!url) return;
+        return {
+          name: title.text().trim(),
+          cover:
+            loadedCheerio(el).find('.tmb-left img').attr('src') || defaultCover,
+          path: new URL(url, this.site).pathname.substring(1),
+        };
+      })
+      .toArray();
+  }
+
+  async popularNovels(
+    page: number,
+    { showLatestNovels }: Plugin.PopularNovelsOptions,
+  ): Promise<Plugin.NovelItem[]> {
+    const body = await fetchApi(
+      `${this.site}novel/page/${page}/?orderby=${showLatestNovels ? 'date' : 'view'}&order=desc`,
+    ).then(r => r.text());
+    return this.parseNovels(parseHTML(body));
+  }
+
+  async parseNovel(novelPath: string): Promise<Plugin.SourceNovel> {
+    const body = await fetchApi(this.site + novelPath).then(r => r.text());
+    const loadedCheerio = parseHTML(body);
+
+    const info = (label: string) =>
+      loadedCheerio('table.info tr')
+        .filter((_, el) => loadedCheerio(el).find('.tbl-lbl').text() === label)
+        .find('td')
+        .last();
+
+    const novel: Plugin.SourceNovel = {
+      path: novelPath,
+      name: loadedCheerio('h1.entry-title').text().trim(),
+      cover:
+        loadedCheerio('.nov-head img.main-tmb').attr('src') || defaultCover,
+      summary: loadedCheerio('.desc p')
+        .map((_, el) => loadedCheerio(el).text().trim())
+        .toArray()
+        .join('\n\n'),
+      author: info('Author').text().trim(),
+      genres: info('Genre')
+        .find('a')
+        .map((_, el) => loadedCheerio(el).text().trim())
+        .toArray()
+        .join(','),
+    };
+
+    const map: Record<string, string> = {
+      ongoing: NovelStatus.Ongoing,
+      completed: NovelStatus.Completed,
+      hiatus: NovelStatus.OnHiatus,
+      dropped: NovelStatus.Cancelled,
+    };
+    novel.status =
+      map[info('Status').text().trim().toLowerCase()] ?? NovelStatus.Unknown;
+
+    novel.chapters = loadedCheerio('.ch-list a.ch-link')
+      .map((index, el) => {
+        const url = loadedCheerio(el).attr('href');
+        if (!url) return;
+        const number = loadedCheerio(el).find('strong').text().trim();
+        loadedCheerio(el).find('strong').remove();
+        return {
+          name: `Chapter ${number.replace('#', '')} ${loadedCheerio(el).text().trim()}`,
+          path: new URL(url, this.site).pathname.substring(1),
+          chapterNumber: index + 1,
+        };
+      })
+      .toArray();
+
+    return novel;
+  }
+
+  async parseChapter(chapterPath: string): Promise<string> {
+    const body = await fetchApi(this.site + chapterPath).then(r => r.text());
+    return parseHTML(body)('#chapter-par').html() || '';
+  }
+
+  async searchNovels(
+    searchTerm: string,
+    page: number,
+  ): Promise<Plugin.NovelItem[]> {
+    const body = await fetchApi(
+      `${this.site}page/${page}/?s=${encodeURIComponent(searchTerm)}&post_type=novel`,
+    ).then(r => r.text());
+    return this.parseNovels(parseHTML(body));
+  }
+}
+
+export default new MTLNovelPlugin();
