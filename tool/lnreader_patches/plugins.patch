+import { Plugin } from '@/types/plugin';
+import { fetchApi } from '@libs/fetch';
+import { NovelStatus } from '@libs/novelStatus';
+import { load as parseHTML } from 'cheerio';
+
+class Dragonholic implements Plugin.PluginBase {
+  id = 'dragonholic';
+  name = 'Dragonholic';
+  site = 'https://dragonholictranslations.com/';
+  version = '2.2.0';
+  icon = 'multisrc/madara/dragonholic/icon.png';
+
+  parseSeries(series: Series[]): Plugin.NovelItem[] {
+    return series.map(item => ({
+      name: parseHTML(item.title.rendered).text(),
+      path: item.link.replace(this.site, ''),
+      cover: item._embedded?.['wp:featuredmedia']?.[0]?.source_url,
+    }));
+  }
+
+  async fetchSeries(params: string): Promise<Plugin.NovelItem[]> {
+    const series = await fetchApi(
+      `${this.site}wp-json/wp/v2/series?per_page=20&_embed=wp:featuredmedia&_fields=title,link,_links,_embedded&${params}`,
+    ).then(res => res.json());
+    return Array.isArray(series) ? this.parseSeries(series) : [];
+  }
+
+  async popularNovels(pageNo: number): Promise<Plugin.NovelItem[]> {
+    return this.fetchSeries(`page=${pageNo}`);
+  }
+
+  async searchNovels(
+    searchTerm: string,
+    pageNo: number,
+  ): Promise<Plugin.NovelItem[]> {
+    return this.fetchSeries(
+      `page=${pageNo}&search=${encodeURIComponent(searchTerm)}`,
+    );
+  }
+
+  async parseNovel(novelPath: string): Promise<Plugin.SourceNovel> {
+    const slug = novelPath.replace(/\/$/, '').split('/').pop();
+    const [series]: Series[] = await fetchApi(
+      `${this.site}wp-json/wp/v2/series?slug=${slug}&_embed=wp:featuredmedia,wp:term&_fields=id,title,link,content,_links,_embedded`,
+    ).then(res => res.json());
+
+    const novel: Plugin.SourceNovel = {
+      path: novelPath,
+      name: parseHTML(series.title.rendered).text(),
+      cover: series._embedded?.['wp:featuredmedia']?.[0]?.source_url,
+      summary: parseHTML(series.content.rendered).text().trim(),
+    };
+
+    const terms = (series._embedded?.['wp:term'] || []).flat();
+    const termNames = (taxonomy: string) =>
+      terms.filter(term => term.taxonomy === taxonomy).map(term => term.name);
+    novel.author = termNames('series-author').join(', ');
+    novel.genres = termNames('genre').join(', ');
+    const status = termNames('story-status').join().toLowerCase();
+    if (status.includes('ongoing')) novel.status = NovelStatus.Ongoing;
+    else if (status.includes('complete')) novel.status = NovelStatus.Completed;
+    else if (status.includes('hiatus')) novel.status = NovelStatus.OnHiatus;
+
+    const chapters: Plugin.ChapterItem[] = [];
+    let totalPages = 1;
+    for (let page = 1; page <= totalPages; page++) {
+      const res = await fetchApi(
+        `${this.site}wp-json/wp/v2/chapter?parent=${series.id}&per_page=100&page=${page}&orderby=date&order=asc&_fields=title,link,date`,
+      );
+      totalPages = Number(res.headers.get('X-WP-TotalPages')) || 1;
+      const items: Chapter[] = await res.json();
+      for (const item of items) {
+        chapters.push({
+          name: parseHTML(item.title.rendered).text(),
+          path: item.link.replace(this.site, ''),
+          releaseTime: item.date,
+          chapterNumber: chapters.length + 1,
+        });
+      }
+    }
+    novel.chapters = chapters;
+
+    return novel;
+  }
+
+  async parseChapter(chapterPath: string): Promise<string> {
+    const body = await fetchApi(this.site + chapterPath).then(res =>
+      res.text(),
+    );
+    return parseHTML(body)('.chapter-content').html() || '';
+  }
+
+  resolveUrl = (path: string) => this.site + path;
+}
+
+export default new Dragonholic();
+
+type Series = {
+  id: number;
+  link: string;
+  title: { rendered: string };
+  content: { rendered: string };
+  _embedded?: {
+    'wp:featuredmedia'?: { source_url: string }[];
+    'wp:term'?: { name: string; taxonomy: string }[][];
+  };
+};
+
+type Chapter = {
+  link: string;
+  date: string;
+  title: { rendered: string };
+};
