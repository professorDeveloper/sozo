new file mode 100644
index 0000000..369e9d9
--- /dev/null
+++ b/plugins/english/penguinsquad.ts
@@ -0,0 +1,130 @@
+import { load as parseHTML } from 'cheerio';
+import { fetchApi } from '@libs/fetch';
+import { Plugin } from '@/types/plugin';
+import { defaultCover } from '@libs/defaultCover';
+import { NovelStatus } from '@libs/novelStatus';
+
+type NovelJSON = {
+  id: string;
+  title: string;
+  slug: string;
+  description: string | null;
+  cover_url: string | null;
+  author: string | null;
+  translator: string | null;
+  status: string | null;
+  genres: string[] | null;
+  free_chapter_floor: number | null;
+};
+
+type ChapterJSON = {
+  title: string;
+  slug: string;
+  chapter_number: number;
+  published_at: string | null;
+};
+
+class PenguinSquadPlugin implements Plugin.PluginBase {
+  id = 'penguinsquad';
+  name = 'Penguin Squad';
+  icon = 'src/en/penguinsquad/icon.png';
+  site = 'https://penguin-squad.com';
+  version = '1.2.0';
+
+  api = 'https://qdqgxwrdzpxpkvamufqp.supabase.co/rest/v1';
+  apiKey = 'sb_publishable_S6npBecKfXVXzyOmhgnWYQ_mccEEiF2';
+
+  async queryAPI<T>(query: string): Promise<T> {
+    return fetchApi(`${this.api}/${query}`, {
+      headers: { apikey: this.apiKey },
+    }).then(r => r.json());
+  }
+
+  async fetchNovels(query: string, page: number) {
+    const novels = await this.queryAPI<NovelJSON[]>(
+      `novels?select=title,slug,cover_url&${query}&limit=20&offset=${(page - 1) * 20}`,
+    );
+    return novels.map(novel => ({
+      name: novel.title,
+      cover: novel.cover_url || defaultCover,
+      path: `novels/${novel.slug}`,
+    }));
+  }
+
+  async popularNovels(
+    page: number,
+    { showLatestNovels }: Plugin.PopularNovelsOptions,
+  ): Promise<Plugin.NovelItem[]> {
+    return this.fetchNovels(
+      showLatestNovels
+        ? 'order=updated_at.desc'
+        : 'order=featured.desc,total_chapters.desc',
+      page,
+    );
+  }
+
+  async parseNovel(novelPath: string): Promise<Plugin.SourceNovel> {
+    const slug = novelPath.split('/').pop();
+    const [data] = await this.queryAPI<NovelJSON[]>(
+      `novels?select=*&slug=eq.${slug}`,
+    );
+
+    const novel: Plugin.SourceNovel = {
+      path: novelPath,
+      name: data.title,
+      cover: data.cover_url || defaultCover,
+      summary: data.description || undefined,
+      author: data.author || undefined,
+      artist: data.translator || undefined,
+      genres: (data.genres || []).join(','),
+    };
+
+    const map: Record<string, string> = {
+      ongoing: NovelStatus.Ongoing,
+      completed: NovelStatus.Completed,
+      hiatus: NovelStatus.OnHiatus,
+      dropped: NovelStatus.Cancelled,
+    };
+    novel.status = map[data.status || ''] ?? NovelStatus.Unknown;
+
+    const chapters = await this.queryAPI<ChapterJSON[]>(
+      `chapters?select=title,slug,chapter_number,published_at&novel_id=eq.${data.id}&order=chapter_number.asc`,
+    );
+    novel.chapters = chapters
+      .filter(
+        chapter =>
+          data.free_chapter_floor == null ||
+          chapter.chapter_number <= data.free_chapter_floor,
+      )
+      .map(chapter => ({
+        name: chapter.title,
+        path: `${novelPath}/${chapter.slug}`,
+        chapterNumber: chapter.chapter_number,
+        releaseTime: chapter.published_at || undefined,
+      }));
+
+    return novel;
+  }
+
+  async parseChapter(chapterPath: string): Promise<string> {
+    const body = await fetchApi(`${this.site}/${chapterPath}`).then(r =>
+      r.text(),
+    );
+    return parseHTML(body)('.reader-content').first().html() || '';
+  }
+
+  async searchNovels(
+    searchTerm: string,
+    page: number,
+  ): Promise<Plugin.NovelItem[]> {
+    const term = encodeURIComponent(
+      searchTerm.replace(/[,()*%_"]/g, ' ').trim(),
+    );
+    return this.fetchNovels(
+      `or=(title.ilike.*${term}*,original_title.ilike.*${term}*,author.ilike.*${term}*)&order=updated_at.desc`,
+      page,
+    );
+  }
+}
+
+export default new PenguinSquadPlugin();
