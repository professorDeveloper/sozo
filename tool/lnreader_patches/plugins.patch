+import { fetchApi } from '@libs/fetch';
+import { Plugin } from '@/types/plugin';
+import { defaultCover } from '@libs/defaultCover';
+import { NovelStatus } from '@libs/novelStatus';
+
+type NovelJSON = {
+  id: string;
+  slug: string | null;
+  title: string;
+  synopsis: string | null;
+  cover_url: string | null;
+  genres: string[] | null;
+  tags: string[] | null;
+  status: string | null;
+  author_name: string | null;
+  translator: string | null;
+};
+
+type ChapterJSON = {
+  number: number;
+  title: string | null;
+  content?: string | null;
+  is_free: boolean;
+  free_date: string | null;
+  published_at: string | null;
+};
+
+class WordExcerptPlugin implements Plugin.PluginBase {
+  id = 'wordexcerpt';
+  name = 'WordExcerpt';
+  icon = 'src/en/wordexcerpt/icon.png';
+  site = 'https://wordexcerpt.com/';
+  version = '2.2.0';
+
+  api = 'https://debebcxopcfhukeqweco.supabase.co/rest/v1';
+  apiKey =
+    'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRlYmViY3hvcGNmaHVrZXF3ZWNvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzA2OTY4NjQsImV4cCI6MjA4NjI3Mjg2NH0._DMgqDOhgT2Z9l4gd0aeCV4dXBARZWRabYDd8__BgEM';
+
+  async queryAPI<T>(query: string): Promise<T> {
+    return fetchApi(`${this.api}/${query}`, {
+      headers: { apikey: this.apiKey },
+    }).then(r => r.json());
+  }
+
+  isFree(chapter: ChapterJSON) {
+    return (
+      chapter.is_free ||
+      (!!chapter.free_date && new Date(chapter.free_date) <= new Date())
+    );
+  }
+
+  async fetchNovels(query: string, page: number) {
+    const novels = await this.queryAPI<NovelJSON[]>(
+      `novels?select=id,slug,title,cover_url&status=neq.draft&${query}&limit=20&offset=${(page - 1) * 20}`,
+    );
+    return novels.map(novel => ({
+      name: novel.title,
+      cover: novel.cover_url || defaultCover,
+      path: `novel/${novel.slug || novel.id}`,
+    }));
+  }
+
+  async popularNovels(
+    page: number,
+    { showLatestNovels }: Plugin.PopularNovelsOptions,
+  ): Promise<Plugin.NovelItem[]> {
+    return this.fetchNovels(
+      `order=${showLatestNovels ? 'updated_at' : 'view_count'}.desc`,
+      page,
+    );
+  }
+
+  async parseNovel(novelPath: string): Promise<Plugin.SourceNovel> {
+    const key = novelPath.split('/')[1];
+    const field = /^[0-9a-f-]{36}$/i.test(key) ? 'id' : 'slug';
+    const [data] = await this.queryAPI<NovelJSON[]>(
+      `novels?select=*&${field}=eq.${encodeURIComponent(key)}`,
+    );
+
+    const map: Record<string, string> = {
+      ongoing: NovelStatus.Ongoing,
+      completed: NovelStatus.Completed,
+      hiatus: NovelStatus.OnHiatus,
+    };
+    const novel: Plugin.SourceNovel = {
+      path: novelPath,
+      name: data.title,
+      cover: data.cover_url || defaultCover,
+      summary: data.synopsis || undefined,
+      author: data.author_name || undefined,
+      artist: data.translator || undefined,
+      genres: [...(data.genres || []), ...(data.tags || [])].join(','),
+      status: map[data.status || ''] ?? NovelStatus.Unknown,
+    };
+
+    const chapters = await this.queryAPI<ChapterJSON[]>(
+      `chapters?select=number,title,is_free,free_date,published_at&novel_id=eq.${data.id}&status=eq.published&order=number.asc`,
+    );
+    novel.chapters = chapters
+      .filter(chapter => this.isFree(chapter))
+      .map(chapter => ({
+        name:
+          `Chapter ${chapter.number}` +
+          (chapter.title ? `: ${chapter.title}` : ''),
+        path: `novel/${data.id}/chapter/${chapter.number}`,
+        chapterNumber: chapter.number,
+        releaseTime: chapter.published_at || undefined,
+      }));
+
+    return novel;
+  }
+
+  async parseChapter(chapterPath: string): Promise<string> {
+    const [, novelId, , number] = chapterPath.split('/');
+    const [chapter] = await this.queryAPI<ChapterJSON[]>(
+      `chapters?select=number,title,content,is_free,free_date,published_at&novel_id=eq.${novelId}&number=eq.${number}`,
+    );
+    if (!chapter || !this.isFree(chapter)) return '';
+    return chapter.content || '';
+  }
+
+  async searchNovels(
+    searchTerm: string,
+    page: number,
+  ): Promise<Plugin.NovelItem[]> {
+    const term = encodeURIComponent(
+      searchTerm.replace(/[,()*%_"]/g, ' ').trim(),
+    );
+    return this.fetchNovels(
+      `or=(title.ilike.*${term}*,author_name.ilike.*${term}*)&order=view_count.desc`,
+      page,
+    );
+  }
+}
+
+export default new WordExcerptPlugin();
