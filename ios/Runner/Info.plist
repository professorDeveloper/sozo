<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Casting. iOS gates both halves: the prompt text below is what the user
	     is shown when the app first looks for a television, and Bonjour service
	     types have to be declared up front or mDNS returns nothing at all — with
	     no error, which reads as "no devices found". -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Sozo looks for Chromecast devices on your Wi-Fi so you can play videos on your TV.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_googlecast._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Kamera televizoringizdagi QR kodni o'qish va profil rasmini olish uchun ishlatiladi.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Profil rasmini tanlash uchun galereyaga ruxsat kerak.</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Sozo</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Sozo</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sozo</string>
			</array>
			<key>CFBundleURLName</key>
			<string>me.azamov.sozo</string>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- "Open with Sozo" for extension repository index files.

	     `index.pb` (Mihon/Keiyoushi, gzipped protobuf) has no registered UTI,
	     so it is declared below as an imported type conforming to public.data.
	     `index.min.json` / `repo.json` / `index.json` are ordinary JSON and are
	     claimed through public.json — the filename is re-checked in
	     RepoFileImport.swift, so claiming JSON broadly costs at most one
	     dismissed sheet. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>me.azamov.sozo.extension-index-pb</string>
			<key>UTTypeDescription</key>
			<string>Extension repository index</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pb</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Extension repository index</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>me.azamov.sozo.extension-index-pb</string>
				<string>public.json</string>
			</array>
		</dict>
	</array>
	<!-- Read the file where it lives instead of forcing a copy into Inbox/.
	     RepoFileImport still copies it into our caches, because the
	     security-scoped access granted here ends when the delegate returns. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Sozo ships one theme and it is dark: `MaterialApp` is pinned to
	     ThemeMode.dark and there is no light palette to switch to. Without this
	     key UIKit still follows the phone's Light/Dark switch, and every
	     surface the app does NOT paint itself came back white on a phone set to
	     Light: the iOS 26 tab bar (Liquid Glass renders *light* under a light
	     trait collection, which is the white capsule with black labels), the
	     keyboard, share sheets, alerts, context menus, the photo picker, and
	     `prefers-color-scheme` inside any WKWebView. Declaring the style makes
	     the app's own trait collection dark, so all of them match the app —
	     and Flutter's `platformBrightness`, which it reads from that same
	     trait collection, reports dark with them. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Used to search by voice.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Used to search by voice.</string>
</dict>
</plist>
